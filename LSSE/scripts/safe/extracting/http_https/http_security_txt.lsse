"""
Light-Scan Scripting Engine (LSSE)
Script Name : http-robots
Author : Adam Boulaaz, ognamgeek
Arguments
--> Required Arguments
----> --domain
--> Optional Arguments
----> None
Categorie :safe/extracting/http-https
"""

import requests

red = "\033[31m"
reset = "\033[0m"

def http_sec(domian):
    try:
        response = requests.get(f'https://{domian}/.well-known/security.txt')

        # Print Status Line
        print(f"HTTP/{response.raw.version} {response.status_code} ")

        print("\n" + "=" * 20 + " BODY " + "=" * 20 + "\n")

        # Print Response Body
        print(response.text)
    except Exception as e:
        print(f"{red}[!] Error in thread: {e}{reset}")



